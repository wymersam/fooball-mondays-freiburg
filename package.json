{
  "name": "football-mondays",
  "version": "1.0.0",
  "description": "Simple web app for managing weekly football sign-ups",
  "main": "main.go",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "go run main.go",
    "client": "vite",
    "build": "vite build",
    "build:go": "go build -o football-mondays .",
    "start": "go run main.go",
    "start:prod": "./football-mondays",
    "preview": "vite preview"
  },
  "keywords": [
    "football",
    "signup",
    "react",
    "typescript",
    "go"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@types/node": "25.2.0",
    "@vitejs/plugin-react": "5.1.3",
    "concurrently": "9.2.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
