{
  "name": "football-mondays",
  "version": "1.0.0",
  "description": "Simple web app for managing weekly football sign-ups",
  "main": "main.go",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "go run main.go",
    "client": "react-scripts start",
    "build": "react-scripts build",
    "build:go": "go build -o football-mondays .",
    "start": "go run main.go",
    "start:prod": "./football-mondays",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "keywords": [
    "football",
    "signup",
    "react",
    "typescript",
    "go"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^16.18.0"
  },
  "proxy": "http://localhost:3001",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
